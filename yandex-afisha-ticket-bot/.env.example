# Full URL of the event page to watch on afisha.yandex.ru
EVENT_URL=https://afisha.yandex.ru/moscow/concert/example-event

# Token from @BotFather (Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCDEF-your-bot-token

# Your Telegram chat id (send a message to your bot, then check
# https://api.telegram.org/bot<TOKEN>/getUpdates to find it)
TELEGRAM_CHAT_ID=123456789

# How often to re-check the page, in seconds
CHECK_INTERVAL_SECONDS=90

# HTTP request timeout, in seconds
REQUEST_TIMEOUT_SECONDS=15

# Where to persist the last known ticket status between runs
STATE_FILE=state.json
